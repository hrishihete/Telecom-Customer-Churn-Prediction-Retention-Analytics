          }
        ],
        "lineageTag": "eb62f33b-8400-42ec-91fa-167b64b515bf",
        "measures": [
          {
            "name": "Active Customers",
            "expression": "COUNTROWS(Customers)",
            "formatString": "#,0",
            "lineageTag": "ea43148a-3636-4323-8759-691563fd0ad3"
          },
          {
            "name": "Average Risk",
            "expression": "AVERAGE(Customers[RiskScore])",
            "formatString": "0.0%",
            "lineageTag": "18a3a29c-2a04-4325-92d5-47a56bbba7f0"
          },
          {
            "name": "High Risk Customers",
            "expression": "CALCULATE(COUNTROWS(Customers), KEEPFILTERS(Customers[RiskScore] >= 0.5))",
            "formatString": "#,0",
            "lineageTag": "a7a39ad3-1476-4177-8b17-bd5ffe5ad099"
          },
          {
            "name": "Monthly Charges CU",
            "expression": "SUM(Customers[MonthlyCharges])",
            "formatString": "#,0.00",
            "lineageTag": "4c2a829b-82bf-4eb7-9031-103d0035fdb3"
          },
          {
            "name": "Revenue at Risk Proxy CU",
            "expression": "SUMX(Customers, Customers[MonthlyCharges] * Customers[RiskScore])",
            "formatString": "#,0.00",
            "lineageTag": "7ca52dd3-9eba-4d67-b468-9b3907cdf1e0"
          },
          {
            "name": "High Risk Monthly Charges CU",
            "expression": "CALCULATE(SUM(Customers[MonthlyCharges]), KEEPFILTERS(Customers[RiskScore] >= 0.5))",
            "formatString": "#,0.00",
            "lineageTag": "fa5cd45f-d3b3-4e91-8d07-b8671ea7b93a"
          },
          {
            "name": "Last Scored UTC",
            "expression": "MAX(Customers[ScoredAtUTC])",
            "lineageTag": "96276d79-3d87-4e12-81bb-cdf7eafd9259"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataPath), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"customerID\", type text}, {\"Contract\", type text}, {\"PaymentMethod\", type text}, {\"InternetService\", type text}, {\"tenure\", Int64.Type}, {\"MonthlyCharges\", type number}, {\"RiskScore\", type number}, {\"RiskBand\", type text}, {\"RiskWeightedMonthlyCharges\", type number}, {\"TenureBand\", type text}, {\"ModelCohort\", type text}, {\"ScoredAtUTC\", type text}, {\"SourceMode\", type text}, {\"ModelVersion\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
